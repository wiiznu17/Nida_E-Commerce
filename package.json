{
  "name": "Nida_Project",
  "private": true,
  "prettier": "@repo/prettier-config",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:store": "turbo run dev --filter=storefront",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:api": "turbo run dev --filter=api",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.6.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
