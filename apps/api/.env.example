# Nida Storefront API Service (Customer Facing)
# Port: 4001 (Storefront API) vs 4000 (Admin API)
PORT=4001
STORE_API_PORT=4001
NODE_ENV=development

# Database Connection
DATABASE_URL="postgresql://nida:nida_dev_password@localhost:5432/nida_ecommerce?schema=public"

# Redis Cache & Rate Limiting
REDIS_URL="redis://localhost:6379"

# Customer JWT Secret (Unique for Storefront Customers)
JWT_CUSTOMER_SECRET="nida_store_customer_jwt_secret_key_2026_luxury_apparel"

OMISE_PUBLIC_KEY="pkey_test_..."
OMISE_SECRET_KEY="skey_test_..."
STORE_FRONTEND_URL="http://localhost:3000"
