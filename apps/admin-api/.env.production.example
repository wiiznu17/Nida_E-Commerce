# NIDA Admin Back-Office API — Production Environment
PORT=4000
NODE_ENV=production

# Database Connection (Supabase / Neon Connection Pooler)
# DATABASE_URL: Transaction Pooler connection (Port 6543) for runtime queries
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?schema=public&pgbouncer=true&connection_limit=10"
# DIRECT_URL: Direct Session connection (Port 5432) for running migrations
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?schema=public"

# Redis Cache, Admin Sessions & Token Storage
REDIS_URL="rediss://default:[password]@[endpoint].upstash.io:6379"
# Or individual host/port if not using rediss:// URL:
# REDIS_HOST="localhost"
# REDIS_PORT=6379
# REDIS_PASSWORD=""

# Admin JWT Secrets (Generate with: openssl rand -base64 48)
# STRICT: In production, must be at least 32 characters and cannot be default string
JWT_ACCESS_SECRET="generate-strong-64-character-cryptographic-random-string-here"
JWT_REFRESH_SECRET="generate-strong-64-character-cryptographic-random-string-here"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# Cloudinary Cloud Storage (MANDATORY on Production)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
# Or individual parameters:
# CLOUDINARY_CLOUD_NAME="your_cloud_name"
# CLOUDINARY_API_KEY="your_api_key"
# CLOUDINARY_API_SECRET="your_api_secret"

# Transactional Mailer (Nodemailer SMTP — Staff Invitations & Password Resets)
MAIL_HOST="smtp.resend.com"
MAIL_PORT=465
MAIL_USER="resend"
MAIL_PASSWORD="re_your_smtp_api_key_here"
MAIL_FROM="\"NIDA Back-Office\" <admin-noreply@yourdomain.com>"

# Omise Payment Gateway (Live Mode for Refunds/Status Inquiry)
OMISE_PUBLIC_KEY="pkey_live_..."
OMISE_SECRET_KEY="skey_live_..."

# Domains & Strict CORS Whitelist
ADMIN_FRONTEND_URL="https://admin.yourdomain.com"
STORE_FRONTEND_URL="https://www.yourdomain.com"
ALLOWED_ORIGINS="https://admin.yourdomain.com"
