# ===========================================
# Root .env — Docker Compose Infrastructure
# ===========================================
# This file configures containers only (PostgreSQL, Redis, pgAdmin).
# Backend apps and Prisma read their own .env files — see README.md.

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=ecommerce_db
POSTGRES_PORT=5432
POSTGRES_CONTAINER_NAME=ecommerce_postgres

# Redis Configuration
REDIS_PASSWORD=redis123
REDIS_PORT=6379
REDIS_CONTAINER_NAME=ecommerce_redis

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
PGADMIN_CONTAINER_NAME=ecommerce_pgadmin
